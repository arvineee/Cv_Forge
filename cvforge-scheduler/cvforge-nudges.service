[Unit]
Description=CVForge Pro upgrade nudges
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/cvforge
EnvironmentFile=/var/www/cvforge/.env
Environment=FLASK_APP=run.py
ExecStart=/var/www/cvforge/venv/bin/flask send-nudges
# A oneshot service never overlaps itself, so two runs cannot double-send.
TimeoutStartSec=15min
