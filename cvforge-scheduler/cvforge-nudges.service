[Unit]
Description=CVForge Pro upgrade nudges
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cvforge
WorkingDirectory=/home/cvforge/Cv_Forge
EnvironmentFile=/home/cvforge/Cv_Forge/.env
Environment=FLASK_APP=run.py
ExecStart=/home/cvforge/Cv_Forge/venv/bin/flask send-nudges
# A oneshot service never overlaps itself, so two runs cannot double-send.
TimeoutStartSec=15min
