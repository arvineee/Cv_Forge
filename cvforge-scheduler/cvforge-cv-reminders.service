[Unit]
Description=CVForge unfinished CV reminders (24h / 72h)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cvforge
WorkingDirectory=/home/cvforge/Cv_Forge
EnvironmentFile=/home/cvforge/Cv_Forge/.env
Environment=FLASK_APP=run.py
ExecStart=/home/cvforge/Cv_Forge/venv/bin/flask send-cv-reminders
TimeoutStartSec=15min
