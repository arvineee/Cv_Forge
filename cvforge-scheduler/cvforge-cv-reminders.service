[Unit]
Description=CVForge unfinished CV reminders (24h / 72h)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/cvforge
EnvironmentFile=/var/www/cvforge/.env
Environment=FLASK_APP=run.py
ExecStart=/var/www/cvforge/venv/bin/flask send-cv-reminders
TimeoutStartSec=15min
