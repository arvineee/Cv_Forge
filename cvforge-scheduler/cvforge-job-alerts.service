[Unit]
Description=CVForge job alert processing
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/cvforge
EnvironmentFile=/var/www/cvforge/.env
Environment=FLASK_APP=run.py
ExecStart=/var/www/cvforge/venv/bin/flask process-job-alerts
# A oneshot service never overlaps itself.
TimeoutStartSec=15min
