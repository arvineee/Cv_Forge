# Copy to .env on the server (never commit .env).
SECRET_KEY=
DATABASE_URL=
SESSION_COOKIE_SECURE=true
# Public address used for canonical URLs, Open Graph and the sitemap
SITE_URL=https://cvforge.site
GEMINI_API_KEY=
GEMINI_MODEL=
INTASEND_SECRET_KEY=
INTASEND_PUBLISHABLE_KEY=
INTASEND_WEBHOOK_CHALLENGE=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=https://cvforge.site/auth/google/callback
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: start a payment provider switched OFF (default is ON).
# Day-to-day, use Admin -> Payment methods instead; that setting wins over these.
# PAYSTACK_ENABLED=true
# INTASEND_ENABLED=true

# Performance and security tuning (safe defaults)
VISITOR_TRACKING_ASYNC=true
VISITOR_TRACKING_QUEUE_SIZE=2048
STATIC_ASSET_MAX_AGE=86400
# Optional: set a tested policy to observe violations without blocking resources.
# CONTENT_SECURITY_POLICY_REPORT_ONLY=default-src 'self'; object-src 'none'; base-uri 'self'

# Job discovery RSS/Atom feeds (optional). Only configure sources you have
# permission to consume and display. Use exact hostnames in the allow-list.
JOB_FEED_ALLOWED_DOMAINS=example.org,careers.example.com
JOB_FEEDS_JSON=[{"name":"Example Careers Feed","url":"https://careers.example.com/jobs/rss.xml","country":"Kenya","location":"Kenya"}]
